# Production default: encrypted WebSocket relay over TLS port 443.
# VITE_TRANSPORT=relay
# Optional alternate Supabase project. Only use a public/publishable key.
# VITE_RELAY_URL=https://your-project.supabase.co
# VITE_RELAY_PUBLISHABLE_KEY=sb_publishable_...

# Explicit optional legacy transport (not required for normal use).
# VITE_TRANSPORT=webrtc
# VITE_PEER_HOST=peer.example.org
# VITE_PEER_PORT=443
# VITE_PEER_PATH=/
# VITE_PEER_SECURE=true
# VITE_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"}]
