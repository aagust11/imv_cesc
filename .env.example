# Static Pages is enabled by the deployment workflow.
# VITE_STATIC_MODE=true

# Optional custom PeerJS signalling server. Leave unset for PeerJS Cloud.
# VITE_PEER_HOST=peer.example.org
# VITE_PEER_PORT=443
# VITE_PEER_PATH=/
# VITE_PEER_SECURE=true

# Optional ICE/TURN configuration (JSON). Frontend variables are public.
# Use short-lived TURN credentials; never commit permanent secrets.
# VITE_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"}]

# Default ICE: public STUN/TURN shipped by PeerJS, with TCP alternatives.
# Optional force-relay mode for testing a restricted network:
# VITE_ICE_TRANSPORT_POLICY=relay
# For production SLA, replace VITE_ICE_SERVERS with your own short-lived TURN credentials.
